{
  "name": "seatsure-enrollment-api",
  "version": "2.0.0",
  "description": "SeatSure - Online Course Enrollment API (Node.js + Express.js + SQL Server)",
  "main": "src/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
